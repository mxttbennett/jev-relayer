{
  "name": "jev-relayer",
  "version": "0.1.0",
  "description": "Routes each Claude Code or Codex task to the right place (inline, subagent or sibling session) and the right model",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20.12" },
  "bin": { "jev-relayer": "bin/jev-relayer.mjs" },
  "scripts": {
    "build:apple": "mkdir -p apple/.build && swiftc -O apple/classify.swift -o apple/.build/jev-apple-classify",
    "test": "node --test test/*.test.mjs",
    "test:mod": "bun test test/register.bun.test.ts",
    "typecheck": "npx -y -p typescript@5.6.3 tsc -p ."
  }
}
